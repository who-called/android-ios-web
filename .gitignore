# Monorepo root ignore (each subproject also has its own .gitignore)
.DS_Store
*.log

# Local agent / tooling artifacts
.entire/
.opencode/

# Node
node_modules/
.next/
out/

# Env / secrets — NEVER commit
.env
.env*.local
**/keystore.properties
**/*.jks
**/*.keystore
android/keystore/

# Build artifacts
*.apk
*.aab
dist/
build/
.gradle/

# Warm-up DB artifacts (generated by `dbforge snapshot`, not source)
**/assets/warmup.sqlite
**/assets/warmup_ios.json
**/assets/manifest.json
**/Resources/warmup_ios.json
