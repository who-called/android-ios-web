# Copy this file to `keystore.properties` (which is gitignored) and fill in your
# real values. NEVER commit keystore.properties or the .jks file.
#
# Generate your own keystore (keep it safe forever — you can't update the app without it):
#   keytool -genkeypair -v -keystore whocalled-release.jks -alias whocalled \
#     -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=keystore/whocalled-release.jks
storePassword=changeit-store
keyAlias=whocalled
keyPassword=changeit-store
