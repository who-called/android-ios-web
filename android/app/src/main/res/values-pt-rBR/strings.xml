    <string name="trace_tuto_title">TUTORIAL — %1$s Como jogar</string>
    <string name="trace_tuto_step0">3 regras, só isso:\n1 golpista por cor -- 1 por linha\ne coluna -- nunca lado a lado</string>
    <string name="trace_tuto_step1">A zona rosa só tem uma casa:\no golpista só pode estar lá.\nToque duas vezes para colocá-lo.</string>
    <string name="trace_tuto_step2">Essas casas nunca vão poder\nter golpista. Marque um X\nnas 3 casas iluminadas.</string>
    <string name="trace_tuto_step3">1 golpista por linha, 1 por coluna:\ncada um no seu lugar. Marque um X nas\n3 casas iluminadas.</string>
    <string name="trace_tuto_step4">Nunca lado a lado, nem\nna diagonal. Marque um X nas\ncasas iluminadas.</string>
    <string name="trace_tuto_step5">Linha 2: só uma casa livre.\nO golpista só pode estar lá.\nToque duas vezes para colocá-lo.</string>
    <string name="trace_tuto_step6">E se você errar?\nToque duas vezes na casa\ncom borda vermelha.</string>
    <string name="trace_tuto_step7">Um 3º toque apaga.\nToque a casa de novo.</string>
    <string name="trace_tuto_step8_a">Só faltam 2 golpistas.\nLinha 3: só uma casa livre.\nToque duas vezes nela.</string>
    <string name="trace_tuto_step8_b">O último: linha 4!\nToque duas vezes nela.</string>
    <string name="trace_tuto_tap_again_place">Mais um toque para colocá-lo!</string>
    <string name="trace_tuto_tap_again">Mais um toque!</string>
    <string name="trace_tuto_tap_again_ellipsis">Mais um toque...</string>
    <string name="trace_tuto_done1">Boa. 1 golpista por cor.</string>
    <string name="trace_tuto_done2">Isso. Cada X elimina uma casa.\nMenos casas = mais fácil\nachar o próximo.</string>
    <string name="trace_tuto_done3">1 golpista por linha, 1 por coluna.\nOs X são sua memória: proibido.</string>
    <string name="trace_tuto_done4">Tudo que encosta num golpista\né seguro: marque com X.</string>
    <string name="trace_tuto_done5">Mandou bem. Os X reduzem as opções\naté sobrar só uma\ncasa possível. Essa é a ideia.</string>
    <string name="trace_tuto_done6">Lugar errado: encostava num golpista.\n-1 vida, -200 pts.</string>
