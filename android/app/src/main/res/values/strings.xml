    <!-- TRACE interactive tutorial -->
    <string name="trace_tuto_title">TUTO — %1$s Comment jouer</string>
    <string name="trace_tuto_step0">3 regles, c\'est tout :\n1 fraudeur par couleur -- 1 par ligne\net colonne -- jamais cote a cote</string>
    <string name="trace_tuto_step1">La zone rose n\'a qu\'une case :\nle fraudeur est forcement la.\nDouble-touche pour le placer.</string>
    <string name="trace_tuto_step2">Ces cases ne pourront jamais\navoir de fraudeur. Pose un X\nsur les 3 cases eclairees.</string>
    <string name="trace_tuto_step3">1 fraudeur par ligne, 1 par colonne :\nchacun sa place. Pose un X sur\nles 3 cases eclairees.</string>
    <string name="trace_tuto_step4">Jamais cote a cote, meme\nen diagonale. Pose un X sur\nles cases eclairees.</string>
    <string name="trace_tuto_step5">Ligne 2 : une seule case libre.\nLe fraudeur est forcement la.\nDouble-touche pour le placer.</string>
    <string name="trace_tuto_step6">Et si on se trompe ?\nDouble-touche la case encadree\nde rouge.</string>
    <string name="trace_tuto_step7">Une 3eme touche efface.\nRetouche la case.</string>
    <string name="trace_tuto_step8_a">Plus que 2 fraudeurs.\nLigne 3 : une seule case libre.\nDouble-touche-la.</string>
    <string name="trace_tuto_step8_b">La derniere : ligne 4 !\nDouble-touche-la.</string>
    <string name="trace_tuto_tap_again_place">Encore une touche pour le placer !</string>
    <string name="trace_tuto_tap_again">Encore une touche !</string>
    <string name="trace_tuto_tap_again_ellipsis">Encore une touche...</string>
    <string name="trace_tuto_done1">Bien. 1 fraudeur par couleur.</string>
    <string name="trace_tuto_done2">Voila. Chaque X elimine une case.\nMoins de cases = plus facile\nde trouver le prochain.</string>
    <string name="trace_tuto_done3">1 fraudeur par ligne, 1 par colonne.\nLes X sont ta memoire : interdit.</string>
    <string name="trace_tuto_done4">Tout ce qui touche un fraudeur\nest sur : on le coche X.</string>
    <string name="trace_tuto_done5">Bien joue. Les X reduisent le champ\njusqu\'a ce qu\'il ne reste qu\'une\ncase possible. C\'est tout le principe.</string>
    <string name="trace_tuto_done6">Mal place : il touchait un fraudeur.\n-1 vie, -200 pts.</string>
    <string name="trace_tuto_done7">Efface. Le cycle :\nvide, X, fraudeur, vide.</string>
    <string name="trace_tuto_done8">Termine. Chaque couleur, chaque ligne,\nchaque colonne a SON fraudeur.\nA toi de jouer !</string>
