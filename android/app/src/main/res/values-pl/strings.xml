    <!-- TRACE interactive tutorial -->
    <string name="trace_tuto_title">SAMOUCZEK — %1$s Jak grać</string>
    <string name="trace_tuto_step0">Tylko 3 zasady:\n1 oszust na kolor -- 1 na wiersz\ni kolumnę -- nigdy obok siebie</string>
    <string name="trace_tuto_step1">Różowa strefa ma tylko jedno pole:\noszust musi tam być.\nDotknij dwukrotnie, aby go postawić.</string>
    <string name="trace_tuto_step2">Na tych polach nigdy\nnie będzie oszusta. Postaw X\nna 3 podświetlonych polach.</string>
    <string name="trace_tuto_step3">1 oszust na wiersz, 1 na kolumnę:\nkażdy ma swoje miejsce. Postaw X\nna 3 podświetlonych polach.</string>
    <string name="trace_tuto_step4">Nigdy obok siebie, nawet\npo przekątnej. Postaw X\nna podświetlonych polach.</string>
    <string name="trace_tuto_step5">Wiersz 2: tylko jedno wolne pole.\nOszust musi tam być.\nDotknij dwukrotnie, aby go postawić.</string>
    <string name="trace_tuto_step6">A jeśli się pomylisz?\nDotknij dwukrotnie pola\nw czerwonej ramce.</string>
    <string name="trace_tuto_step7">3. dotknięcie czyści.\nDotknij pola jeszcze raz.</string>
    <string name="trace_tuto_step8_a">Zostało dwóch oszustów.\nWiersz 3: tylko jedno wolne pole.\nDotknij go dwukrotnie.</string>
    <string name="trace_tuto_step8_b">Ostatni: wiersz 4!\nDotknij go dwukrotnie.</string>
    <string name="trace_tuto_tap_again_place">Jeszcze jedno dotknięcie, aby postawić!</string>
    <string name="trace_tuto_tap_again">Jeszcze jedno dotknięcie!</string>
    <string name="trace_tuto_tap_again_ellipsis">Jeszcze jedno dotknięcie...</string>
    <string name="trace_tuto_done1">Dobrze. 1 oszust na kolor.</string>
    <string name="trace_tuto_done2">Właśnie tak. Każdy X wyklucza pole.\nMniej pól = łatwiej\nznaleźć następnego.</string>
    <string name="trace_tuto_done3">1 oszust na wiersz, 1 na kolumnę.\nX to Twoja pamięć: tu nie wolno.</string>
    <string name="trace_tuto_done4">Wszystko, co dotyka oszusta,\njest bezpieczne: zaznacz X.</string>
    <string name="trace_tuto_done5">Brawo. X zawężają pole\naż zostanie tylko jedno\nmożliwe pole. Na tym to polega.</string>
    <string name="trace_tuto_done6">Źle postawiony: dotykał oszusta.\n-1 życie, -200 pkt.</string>
    <string name="trace_tuto_done7">Wyczyszczone. Cykl:\npuste, X, oszust, puste.</string>
    <string name="trace_tuto_done8">Gotowe. Każdy kolor, każdy wiersz,\nkażda kolumna ma SWOJEGO oszusta.\nTwój ruch!</string>
