    <!-- TRACE interactive tutorial -->
    <string name="trace_tuto_title">NÁVOD — %1$s Ako hrať</string>
    <string name="trace_tuto_step0">3 pravidlá, nič viac:\n1 podvodník na farbu -- 1 na riadok\na stĺpec -- nikdy vedľa seba</string>
    <string name="trace_tuto_step1">Ružová zóna má len jedno pole:\npodvodník musí byť tam.\nDvojitým klepnutím ho umiestni.</string>
    <string name="trace_tuto_step2">Na týchto poliach nikdy nemôže\nbyť podvodník. Daj X\nna 3 zvýraznené polia.</string>
    <string name="trace_tuto_step3">1 podvodník na riadok, 1 na stĺpec:\nkaždý má svoje miesto. Daj X\nna 3 zvýraznené polia.</string>
    <string name="trace_tuto_step4">Nikdy vedľa seba, ani\nuhlopriečne. Daj X\nna zvýraznené polia.</string>
    <string name="trace_tuto_step5">Riadok 2: len jedno voľné pole.\nPodvodník musí byť tam.\nDvojitým klepnutím ho umiestni.</string>
    <string name="trace_tuto_step6">A čo keď sa pomýliš?\nDvakrát klepni na pole\nv červenom rámčeku.</string>
    <string name="trace_tuto_step7">Tretie klepnutie maže.\nKlepni na pole znova.</string>
    <string name="trace_tuto_step8_a">Zostávajú 2 podvodníci.\nRiadok 3: len jedno voľné pole.\nDvakrát naň klepni.</string>
    <string name="trace_tuto_step8_b">Posledný: riadok 4!\nDvakrát naň klepni.</string>
    <string name="trace_tuto_tap_again_place">Ešte jedno klepnutie a je umiestnený!</string>
    <string name="trace_tuto_tap_again">Ešte jedno klepnutie!</string>
    <string name="trace_tuto_tap_again_ellipsis">Ešte jedno klepnutie...</string>
    <string name="trace_tuto_done1">Dobre. 1 podvodník na farbu.</string>
    <string name="trace_tuto_done2">Tak. Každé X vyradí jedno pole.\nMenej polí = ľahšie\nnájsť ďalšieho.</string>
    <string name="trace_tuto_done3">1 podvodník na riadok, 1 na stĺpec.\nX sú tvoja pamäť: zakázané.</string>
    <string name="trace_tuto_done4">Všetko, čo sa dotýka podvodníka,\nje bezpečné: označ to X.</string>
    <string name="trace_tuto_done5">Výborne. X zužujú možnosti,\nkým nezostane jediné\nmožné pole. V tom je celý princíp.</string>
    <string name="trace_tuto_done6">Zle umiestnený: dotýkal sa podvodníka.\n-1 život, -200 b.</string>
    <string name="trace_tuto_done7">Vymazané. Cyklus:\nprázdne, X, podvodník, prázdne.</string>
    <string name="trace_tuto_done8">Hotovo. Každá farba, každý riadok,\nkaždý stĺpec má SVOJHO podvodníka.\nTeraz ty!</string>
