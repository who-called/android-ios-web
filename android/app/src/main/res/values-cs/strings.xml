    <!-- TRACE interactive tutorial -->
    <string name="trace_tuto_title">NÁVOD — %1$s Jak hrát</string>
    <string name="trace_tuto_step0">3 pravidla, nic víc:\n1 podvodník na barvu -- 1 na řádek\na sloupec -- nikdy vedle sebe</string>
    <string name="trace_tuto_step1">Růžová zóna má jen jedno pole:\npodvodník musí být tam.\nDvojitým klepnutím ho umísti.</string>
    <string name="trace_tuto_step2">Na těchto polích nikdy nemůže\nbýt podvodník. Dej X\nna 3 zvýrazněná pole.</string>
    <string name="trace_tuto_step3">1 podvodník na řádek, 1 na sloupec:\nkaždý má své místo. Dej X\nna 3 zvýrazněná pole.</string>
    <string name="trace_tuto_step4">Nikdy vedle sebe, ani\núhlopříčně. Dej X\nna zvýrazněná pole.</string>
    <string name="trace_tuto_step5">Řádek 2: jen jedno volné pole.\nPodvodník musí být tam.\nDvojitým klepnutím ho umísti.</string>
    <string name="trace_tuto_step6">A co když se spleteš?\nDvakrát klepni na pole\nv červeném rámečku.</string>
    <string name="trace_tuto_step7">Třetí klepnutí maže.\nKlepni na pole znovu.</string>
    <string name="trace_tuto_step8_a">Zbývají 2 podvodníci.\nŘádek 3: jen jedno volné pole.\nDvakrát na něj klepni.</string>
    <string name="trace_tuto_step8_b">Poslední: řádek 4!\nDvakrát na něj klepni.</string>
    <string name="trace_tuto_tap_again_place">Ještě jedno klepnutí a je umístěn!</string>
    <string name="trace_tuto_tap_again">Ještě jedno klepnutí!</string>
    <string name="trace_tuto_tap_again_ellipsis">Ještě jedno klepnutí...</string>
    <string name="trace_tuto_done1">Dobře. 1 podvodník na barvu.</string>
    <string name="trace_tuto_done2">Tak. Každé X vyřadí jedno pole.\nMéně polí = snazší\nnajít dalšího.</string>
    <string name="trace_tuto_done3">1 podvodník na řádek, 1 na sloupec.\nX jsou tvoje paměť: zakázáno.</string>
    <string name="trace_tuto_done4">Vše, co se dotýká podvodníka,\nje bezpečné: označ to X.</string>
    <string name="trace_tuto_done5">Výborně. X zužují možnosti,\ndokud nezbude jediné\nmožné pole. V tom je celý princip.</string>
    <string name="trace_tuto_done6">Špatně umístěn: dotýkal se podvodníka.\n-1 život, -200 b.</string>
    <string name="trace_tuto_done7">Smazáno. Cyklus:\nprázdné, X, podvodník, prázdné.</string>
    <string name="trace_tuto_done8">Hotovo. Každá barva, každý řádek,\nkaždý sloupec má SVÉHO podvodníka.\nTeď ty!</string>
