    <!-- SMS shield -->
    <string name="sms_title">SMS-Schutz</string>
    <string name="sms_subtitle">Unerwünschte SMS ausblenden</string>
    <string name="sms_access_required">Zugriff auf Benachrichtigungen nötig</string>
    <string name="sms_access_body">Um unerwünschte SMS auszublenden, erlaube Who Called den Zugriff auf Benachrichtigungen. Wir lesen nie den Inhalt deiner Nachrichten: Wir blenden nur die Benachrichtigung eines unerwünschten Absenders aus. Die SMS bleibt in deiner Nachrichten-App.</string>
    <string name="sms_access_button">Zugriff auf Benachrichtigungen aktivieren</string>
    <string name="sms_hide_title">Benachrichtigungen unerwünschter SMS ausblenden</string>
    <string name="sms_hide_desc">Die Nachricht bleibt ungelesen in deiner SMS-App. Keine Nachricht wird gelesen oder gelöscht.</string>
    <string name="sms_notify_title">Bei ausgeblendeter SMS benachrichtigen</string>
    <string name="sms_notify_desc">Zeigt eine dezente Benachrichtigung, wenn eine unerwünschte SMS ausgeblendet wird.</string>
    <string name="sms_how_title">So funktioniert\'s</string>
    <string name="sms_how_body">Android erlaubt das Blockieren von SMS nur der Standard-Nachrichten-App. Who Called bleibt ein Filter: Wir blenden nur die Benachrichtigung von Absendern mit hohem Spam-Score aus – anhand derselben Liste wie bei Anrufen.</string>

