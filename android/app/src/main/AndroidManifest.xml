<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Read the system call log so the user can report from their recent calls. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <application
        android:name=".WhoCalledApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WhoCalled">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WhoCalled">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Share sheet: let users share a number or an SMS text from any app
              (Messages, Phone, browser…) into Who Called to report it. No SMS
              permission, no passive reading — the user explicitly shares.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Real-time call screening: block + WARN (signature feature) -->
        <service
            android:name=".service.WhoCalledScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!--
          SMS shield: hide the notification of an unwanted SMS posted by the
          default SMS app. The message stays in the SMS app (we do not read or
          delete SMS, and we are not the default SMS app). Requires the user to
          grant notification access in system settings. Opt-in.
        -->
        <service
            android:name=".service.SmsNotificationListener"
            android:exported="true"
            android:label="@string/sms_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
