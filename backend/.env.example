# Copy to .env. Local dev uses the docker-compose Postgres (no SSL).
# In production (Hetzner CNPG) the secret uses:
#   postgresql://whocalled_app:<pw>@sides-postgres-rw.db-prod:5432/whocalled?sslmode=require
DATABASE_URL="postgresql://whocalled:whocalled@localhost:5432/whocalled?schema=public"
PORT=3000

# Scoring thresholds (0..100). Tune as real data arrives.
SCORE_BLOCK_THRESHOLD=85
SCORE_WARN_THRESHOLD=60
# Minimum (weighted) report volume before a number can reach "block" status.
MIN_REPORTS_FOR_BLOCK=5

# Time decay: a report's weight halves every N days.
SCORE_HALF_LIFE_DAYS=30
# Velocity: >= THRESHOLD spam reports within WINDOW days adds BOOST to the score.
SCORE_VELOCITY_WINDOW_DAYS=1
SCORE_VELOCITY_THRESHOLD=5
SCORE_VELOCITY_BOOST=10
# Reputation (anti-poisoning): agreeing/disagreeing with consensus moves a
# device's weight by STEP×strength; consensus counts once weighted volume >= MIN.
REPUTATION_STEP=0.1
CONSENSUS_MIN_WEIGHT=3

# Uncontradicted spam weight needed before a number shows as "warn" below the
# warn score band (≈ two fresh devices). One lone report is counted, not flagged.
MIN_WEIGHT_FOR_WARN=1.5

# Anti-abuse
MAX_REPORTS_PER_DEVICE_PER_DAY=50
# Brand-new device ids one IP may register per day (anti-Sybil; known devices exempt).
MAX_NEW_DEVICES_PER_IP_PER_DAY=20

# Operator token for DELETE /api/v1/privacy/number/:phone (third-party erasure
# requests received at privacy@who-called.com). Unset = endpoint disabled.
#   curl -X DELETE -H "Authorization: Bearer $PRIVACY_ADMIN_TOKEN" https://api…/api/v1/privacy/number/33612345678
PRIVACY_ADMIN_TOKEN=

# Web origins allowed to call the API from a browser (the website widget).
CORS_ORIGINS=http://localhost:3000,https://www.who-called.com

# ARCEP / operator block list (Saracroche-compatible JSON). Mirror your own JSON
# and change this URL if needed. Import with `pnpm arcep`.
ARCEP_LIST_URL=https://saracroche.org/api/v1/lists/french-list-arcep-operators

# RGPD data minimization: raw reports older than this many days are purged
# (`pnpm purge`, wire to cron). Numbers with no remaining reports are removed.
REPORT_RETENTION_DAYS=365

# Public reassurance stats (GET /api/v1/stats) shown in the apps' home banner.
# coveredNumbers = BASE_COVERED_OFFSET + arcepPatterns × NUMBERS_PER_ARCEP_PATTERN
#                  + live community count. Labelled "numéros couverts" in the UI.
STATS_NUMBERS_PER_ARCEP_PATTERN=10000
STATS_BASE_COVERED_OFFSET=500000
